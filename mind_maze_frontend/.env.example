# React env example for Mind Maze (no secrets)
REACT_APP_FEATURE_FLAGS=confetti=true
REACT_APP_EXPERIMENTS_ENABLED=true

# Supabase (required to enable persistence and auth)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional: front-end URL for auth email redirects
REACT_APP_FRONTEND_URL=http://localhost:3000
