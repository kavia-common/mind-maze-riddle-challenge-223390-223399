# Copy to .env or .env.local for local development
# Supabase (public client-side values)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional flags & settings
REACT_APP_FEATURE_FLAGS=confetti=true
REACT_APP_EXPERIMENTS_ENABLED=true

# Optional: used for email confirmation redirects if you enable email signup flows
REACT_APP_FRONTEND_URL=http://localhost:3000
