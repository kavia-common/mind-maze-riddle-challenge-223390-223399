# Copy this file to .env or .env.local and fill in values.
# Never commit your real .env files to source control.

# Core app flags (optional)
REACT_APP_FEATURE_FLAGS=confetti=true
REACT_APP_EXPERIMENTS_ENABLED=true

# Supabase (required for persistence and auth)
# Use the Supabase project URL and anon (public) key provided by your project.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional frontend URL for auth email redirects, if you enable email signups
# Example: http://localhost:3000
REACT_APP_FRONTEND_URL=
