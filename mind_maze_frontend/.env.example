# Mind Maze Frontend - Environment Variables (React)
# Note: Never commit real secrets. These keys are safe to expose on the client but still keep them out of source for flexibility.

# Supabase public URL and anon key
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Existing optional flags (examples)
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
