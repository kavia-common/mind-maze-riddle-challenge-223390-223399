# Client-side (React) - safe to expose in browser build
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
# Some environments may provide REACT_APP_SUPABASE_KEY; anon key is preferred
# REACT_APP_SUPABASE_KEY=
REACT_APP_FRONTEND_URL=
# Optional: point frontend services to the internal API proxy (defaults to none, direct Supabase client)
REACT_APP_API_BASE=http://localhost:4000

# Server-side (Node API) - DO NOT expose to client, set only in server environment
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
API_PORT=4000
API_TRUST_PROXY=false
NODE_ENV=development
