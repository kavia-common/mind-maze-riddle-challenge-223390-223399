# React environment variables (no secrets beyond Supabase anon key)
REACT_APP_NODE_ENV=development
REACT_APP_FEATURE_FLAGS=confetti=true
REACT_APP_EXPERIMENTS_ENABLED=true

# Supabase (required for persistence)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-public-anon-key

# Optional - used in auth email redirects if you implement signups
REACT_APP_FRONTEND_URL=http://localhost:3000
